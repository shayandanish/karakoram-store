# ── Karakoram Store – Client Environment Variables ───────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Backend API base URL (no trailing slash). Defaults to localhost:5000 if unset.
VITE_API_URL=http://localhost:5000/api

# Your WhatsApp business number in international format (digits only or with +)
# e.g. +923001234567  — used for "Order on WhatsApp" links
VITE_WHATSAPP_NUMBER=+923001234567

# Cloudinary cloud name — enables automatic image width/quality optimisation.
# Leave blank if you have not set up Cloudinary yet.
VITE_CLOUDINARY_CLOUD_NAME=
