NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=your_mongodb_connection_string

# JWT
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Firebase Admin — required for email verification, Google sign-in and account management.
# Create a service account in Firebase Console → Project settings → Service accounts,
# then paste the three values below. Keep the private key's \n escapes intact.
# Enable Email/Password and Google under Authentication → Sign-in method.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Seed script: used by npm run seed only
ADMIN_EMAIL=admin@karakoramstore.com
ADMIN_PASSWORD=Change_Me_Str0ng!

# Transactional Email (Resend — Recommended, 3,000 free emails/month at https://resend.com)
RESEND_API_KEY=re_your_api_key
# Sender header: with verified domain use orders@yourdomain.com, or onboarding@resend.dev for test
EMAIL_FROM=Karakoram Store <onboarding@resend.dev>

# Nodemailer / Email Configuration (Fallback)
# Optional in development (falls back to Ethereal test account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Karakoram Store" <noreply@karakoramstore.com>